# Google Gemini API Key
# Get yours at https://aistudio.google.com/
NUXT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional, defaults to gemini-3.8-flash (2.5 models are closed to new API keys)
# NUXT_GEMINI_MODEL=gemini-3.8-flash

# Backend API (optional, defaults to the VPS in nuxt.config.ts)
# NUXT_API_BASE=https://vps123922.serveur-vps.net
