{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:report": "vitest run --reporter=json --outputFile=tests/reports/unit.json ; playwright test ; node tests/report.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nuxt/fonts": "^1.0.1",
    "@nuxtjs/sitemap": "^8.0.15",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "dompurify": "^3.4.16",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^17.0.5",
    "nuxt": "^4.6.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13"
